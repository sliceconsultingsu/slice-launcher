/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slice-launcher",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-10-02",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "MEMBERSHIP_DB",
      "database_name": "slice-membership",
      "database_id": "393d57d2-a0a9-443f-8c4c-e0884b5a7f51",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://snowy-voice-36a1.cloudflareaccess.com",
    "ACCESS_AUD": "a176f7f76272a49ac4575fe315783b6cf1c5129bbdd95f666ebe3c046da7008f",
    // AI connection status and the connected-apps list stay hidden until production AI sign-in
    // is verified. Only the exact value "true" turns them on. See docs/mcp.md.
    "AI_CONNECTIONS_ENABLED": "false",
  },
  // Grants, passes and AI activity records for Slice's own AI sign-in (namespace
  // "slice-launcher-oauth", created November 5, 2026). Never share it with another app.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "8a8e78a4b2184dca965ed1fea05e680d",
    },
  ],
  // Per-address limit for AI app registration and pass requests (20 a minute).
  "ratelimits": [
    {
      "name": "OAUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
