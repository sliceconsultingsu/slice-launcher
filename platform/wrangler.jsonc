/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slice-launcher",
  "workers_dev": true,
  "preview_urls": false,
  // The launcher's own address. Cloudflare creates the DNS record and certificate. The release
  // token must be able to see the sliceos.app zone. See docs/launcher-address.md.
  "routes": [{ "pattern": "sliceos.app", "custom_domain": true }],
  "compatibility_date": "2026-10-02",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "MEMBERSHIP_DB",
      "database_name": "slice-membership",
      "database_id": "393d57d2-a0a9-443f-8c4c-e0884b5a7f51",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // Slice's own Google sign-in (docs/membership.md). The client secret is a Worker secret
    // (GOOGLE_CLIENT_SECRET), never in Git. Sign-in fails closed until both are set.
    "GOOGLE_CLIENT_ID": "677700569745-phm73t1747rms1du0luqve1jbcoo9kvj.apps.googleusercontent.com",
    // The retired Cloudflare Access issuer, used only to move existing members to their Google
    // identity on first sign-in.
    "LEGACY_ACCESS_ISSUER": "https://snowy-voice-36a1.cloudflareaccess.com",
    // AI connection status and the connected-apps list stay hidden until production AI sign-in
    // is verified. Only the exact value "true" turns them on. See docs/mcp.md.
    "AI_CONNECTIONS_ENABLED": "true",
    // The one address Slice tells people to use, and the earlier hosts that redirect to it
    // (comma-separated). An empty FORMER_HOSTS redirects nothing: both addresses serve.
    // The workers.dev address must stay switched on (workers_dev above) for its redirect to work.
    "LAUNCHER_ORIGIN": "https://sliceos.app",
    // Member apps (docs/member-apps.md) stay off until this is exactly "true" and the APP_FILES
    // store is bound. Off: no app address is served and the app tools are not offered.
    "MEMBER_APPS_ENABLED": "false",
    "FORMER_HOSTS": "slice-launcher.ivan27chen.workers.dev",
  },
  // Grants, passes and AI activity records for Slice's own AI sign-in (namespace
  // "slice-launcher-oauth", created November 5, 2026). Never share it with another app.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "8a8e78a4b2184dca965ed1fea05e680d",
    },
  ],
  // Per-address limits: AI app registration and passes (OAUTH_LIMITER), 20 a minute, and
  // completed Google sign-ins (AUTH_LIMITER), 60 a minute so a room of people on one shared
  // network can sign in together. Per-person limit: membership changes (WRITE_LIMITER),
  // 30 a minute.
  "ratelimits": [
    {
      "name": "OAUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
